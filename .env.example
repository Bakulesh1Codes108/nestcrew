# Copy this file to .env and fill in only the keys you have.
# All are OPTIONAL - NestCrew works fully offline without any of them.
# .env is in .gitignore, so your keys never get pushed to GitHub.

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=

# Optional quick overrides
# NESTCREW_MODE=local
# NESTCREW_LOCAL_MODEL=qwen3-vl:2b-instruct
